{% extends 'base.html.twig' %}

{% block title %}Nos Enseignements - Mille et une notes{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-4 py-12">

        <div class="text-center mb-16">
            <h1 class="text-4xl font-extrabold text-[#2b1810] tracking-tight">Détail des enseignements</h1>
            <p class="mt-4 text-[#7d5e54]">Découvrez en profondeur chaque parcours musical proposé par notre école.</p>
        </div>

        <div class="flex flex-col gap-12">
            {% for discipline in disciplines %}
                {# L'attribut id est crucial ici pour l'ancre, scroll-mt-24 évite que le titre colle trop en haut de l'écran #}
                <section id="cours-{{ discipline.id }}" class="bg-white rounded-2xl border border-[#ebd0c7] shadow-sm overflow-hidden flex flex-col md:flex-row scroll-mt-24">

                    {# Zone Image (plus grande sur cette page) #}
                    <div class="md:w-1/3 bg-[#ecd3cb] flex flex-col items-center justify-center text-[#935848] text-sm font-medium border-b md:border-b-0 md:border-r border-[#e5c0b5] p-8 min-h-[200px]">
                        <span class="text-4xl mb-2">🎵</span>
                        <span class="text-center">Image {{ discipline.nom }}</span>
                    </div>

                    {# Zone Détails #}
                    <div class="p-8 md:w-2/3 flex flex-col justify-center">
                        <h2 class="text-2xl font-bold text-[#2b1810] mb-4">{{ discipline.nom }}</h2>

                        <p class="text-[#6e544c] leading-relaxed mb-6">
                            {{ discipline.description }}
                        </p>

                        <div class="mt-auto">
                            <a href="{{ path('accueil') }}" class="inline-flex items-center gap-2 text-[#b85d43] hover:text-[#935848] font-semibold text-sm transition">
                                <span>←</span> Retour à l'accueil
                            </a>
                        </div>
                    </div>

                </section>
            {% else %}
                <div class="text-center py-10 text-[#7d5e54]">Aucun enseignement trouvé.</div>
            {% endfor %}
        </div>

    </div>
{% endblock %}
