{% extends 'base.html.twig' %}

{% block title %}Inscription - École de Musique{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 850px; margin: 0 auto; font-family: Arial, sans-serif;">
    <h1 style="text-align: center; color: #2c3e50; margin-bottom: 30px;">Formulaire de Pré-inscription</h1>

    {# 1. Affichage du message flash vert si la base de données enregistre avec succès #}
    {% for message in app.flashes('success') %}
        <div style="background-color: #d4edda; color: #155724; padding: 15px; border-radius: 5px; margin-bottom: 25px; border: 1px solid #c3e6cb;">
            {{ message }}
        </div>
    {% endfor %}

    {# 2. Balise de départ du formulaire Symfony #}
    {{ form_start(form_inscription) }}
        
        {# === SECTION ÉLÈVE (Formulaire imbriqué) === #}
        <fieldset style="border: 1px solid #3498db; padding: 25px; border-radius: 8px; margin-bottom: 25px; background-color: #f8f9fa;">
            <legend style="font-weight: bold; color: #3498db; padding: 0 10px; font-size: 1.2rem;">1. Identité de l'Élève</legend>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 10px;">
                <div>{{ form_row(form_inscription.id_eleve.nom, {'label': 'Nom de famille : '}) }}</div>
                <div>{{ form_row(form_inscription.id_eleve.prenom, {'label': 'Prénom : '}) }}</div>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 15px; margin-top: 15px;">
                <div>{{ form_row(form_inscription.id_eleve.date_naissance, {'label': 'Date de naissance : '}) }}</div>
                <div>{{ form_row(form_inscription.id_eleve.age, {'label': 'Âge : '}) }}</div>
            </div>

            <div style="margin-top: 15px;">
                {{ form_row(form_inscription.id_eleve.email, {'label': 'Adresse Email de contact : '}) }}
            </div>

            <div style="margin-top: 15px;">
                {{ form_row(form_inscription.id_eleve.adresse_principale, {'label': 'Adresse Postale Résidentielle : '}) }}
            </div>

            <div style="margin-top: 15px;">
                {{ form_row(form_inscription.id_eleve.cycle_musical, {'label': 'Cursus / Cycle Musical : '}) }}
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 15px;">
                <div>{{ form_row(form_inscription.id_eleve.tel_portable, {'label': 'Portable : '}) }}</div>
                <div>{{ form_row(form_inscription.id_eleve.tel_domicile, {'label': 'Fixe Domicile : '}) }}</div>
                <div>{{ form_row(form_inscription.id_eleve.tel_professionnel, {'label': 'Bureau : '}) }}</div>
            </div>

            <!-- <div style="margin-top: 15px; display: flex; align-items: center;">
                {{ form_row(form_inscription.id_eleve.eleve_majeur, {'label': 'L\'élève est majeur : '}) }}
            </div>-->
        </fieldset>

        {# === SECTION INSCRIPTION (Champs principaux) === #}
        <fieldset style="border: 1px solid #2ecc71; padding: 25px; border-radius: 8px; margin-bottom: 35px; background-color: #f8f9fa;">
            <legend style="font-weight: bold; color: #2ecc71; padding: 0 10px; font-size: 1.2rem;">2. Options d'Inscription & Cours</legend>
            
            <!--<div style="margin-top: 10px;">
                {{ form_row(form_inscription.id_cours, {'label': 'Sélection du Cours de musique : '}) }}
            </div>-->

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px;">
                <div>{{ form_row(form_inscription.coeff_famillial, {'label': 'Quotient / Coeff Familial : '}) }}</div>
                <div>{{ form_row(form_inscription.police_assurance, {'label': 'Numéro d\'attestation d\'assurance : '}) }}</div>
            </div>
        </fieldset>

        {# === SECTION RESPONSABLES LÉGAUX === #}
        <fieldset style="border: 1px solid #e67e22; padding: 25px; border-radius: 8px; margin-bottom: 25px; background-color: #f8f9fa;">
            <legend style="font-weight: bold; color: #e67e22; padding: 0 10px; font-size: 1.2rem;">3. Responsables Légaux</legend>
            
            <div style="margin-top: 10px;">
                {{ form_row(form_inscription.id_responsable_legal_1, {'label': 'Responsable légal 1 : '}) }}
            </div>

            <div style="margin-top: 15px;">
                {{ form_row(form_inscription.id_responsable_legal_2, {'label': 'Responsable légal 2 : '}) }}
            </div>
        </fieldset>

        {# === BOUTON DE SOUMISSION === #}
        <div style="text-align: center;">
            <button type="submit" style="background-color: #2c3e50; color: white; padding: 15px 50px; border: none; border-radius: 5px; font-size: 18px; cursor: pointer; font-weight: bold; transition: background 0.2s;">
                Valider et Transmettre l'Inscription
            </button>
        </div>

    {# 3. Balise de fin du formulaire Symfony #}
    {{ form_end(form_inscription) }}
</div>
{% endblock %}
