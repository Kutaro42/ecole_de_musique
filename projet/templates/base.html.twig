<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Ecole Mille et une notes{% endblock %}</title>
        <script src="https://cdn.tailwindcss.com"></script>

    </head>
    <body>
    <header class="w-full h-16 px-4 rounded-none bg-white flex items-center justify-between ">

        <div class="flex items-center gap-4">
            <a href="{{ path('accueil') }}">
                <img src="https://cdn-icons-png.flaticon.com/512/461/461095.png" width="30px" height="30px">
                <div>
                    <p class="font-bold leading-tight text-orange-500">Mille et une notes</p>
                    <p class="text-xs text-gray-500">Ecole de musique et d'éveil artistique</p>
                </div>
            </a>

        </div>

        <nav role="navigation">
            <a href="{{ path('enseignements') }}" class="px-3 py-1.5 text-sm font-medium text-gray-700 hover:text-orange-500 hover:bg-orange-50 rounded-md transition-colors">
                Enseignements
            </a>
            <a href="{{ path('app_inscription') }}" class="px-3 py-1.5 text-sm font-medium text-gray-700 hover:text-orange-500 hover:bg-orange-50 rounded-md transition-colors">
                Inscription
            </a>

        </nav>
    </header>


            {% block body %}{% endblock %}

    <footer class="w-full bg-gray-900 text-gray-300 px-4 py-6 ">
        <div class="flex flex-row items-center">
            © 2026 Mille et une notes. Tous droits réservés.
        </div>
    </footer>
    </body>
</html>
